{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "C/C++: cl.exe build active file",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/c",
				"${workspaceFolder}\\.vscode\\build.cmd"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: MSVC cl.exe (Visual Studio 2022 Community)"
		}
	]
}
